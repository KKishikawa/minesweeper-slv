{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2023", "DOM", "WebWorker"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
