{
  "name": "minesweeper-slv",
  "private": true,
  "version": "0.1.0-dev.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ci": "tsx scripts/ci/run-tests.ts",
    "test:spike-evidence": "vitest run --config vitest.spike.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "browsers:install:spike": "playwright install chromium firefox webkit",
    "spike:recognition": "tsx scripts/run-multi-prototype-spike.ts",
    "fixtures:audit": "tsx scripts/recognition/audit-dataset.ts",
    "fixtures:derive": "tsx scripts/recognition/derive-dataset.ts",
    "test:browser": "vitest run test/browser",
    "diagnostics:replay": "tsx scripts/solver/replay.ts",
    "build:pages": "vite build --base=/minesweeper-slv/"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
