--- /dev/null
+++ b/profile-timing.ts
@@ -0,0 +1,10 @@
+import { writeFileSync } from "node:fs";
+import { performance } from "node:perf_hooks";
+const metrics: { name: string; value: number }[] = [];
+export function __profileMetric(name: string, value: number) { metrics.push({ name, value }); }
+const events: { name: string; start: number; end: number }[] = [];
+export function __profileEnter(name: string) { return { name, start: performance.now(), end: 0 }; }
+export function __profileExit(event: { name: string; start: number; end: number }) { event.end = performance.now(); events.push(event); }
+export async function __profileAsync<T>(name: string, action: () => Promise<T>): Promise<T> { const token = __profileEnter(name); try { return await action(); } finally { __profileExit(token); } }
+export function __profileSync<T>(name: string, action: () => T): T { const token = __profileEnter(name); try { return action(); } finally { __profileExit(token); } }
+process.on("exit", () => { if (process.env.PROFILE_TIMING_PREFIX) writeFileSync(process.env.PROFILE_TIMING_PREFIX + "-" + process.pid + ".json", JSON.stringify({ pid: process.pid, events, metrics })); });
